{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "types": ["node"],

    // Deliberately NO "baseUrl". With baseUrl set to the project root, any
    // bare import resolves against root-level folders BEFORE node_modules —
    // so `import { Composition } from "remotion"` silently resolved to our
    // own ./remotion/ folder instead of the npm package, and every Remotion
    // export appeared to not exist. "paths" works without baseUrl on
    // TypeScript 4.4+ (resolved relative to this file), so the @/ alias is
    // unaffected. Don't add baseUrl back.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "electron",
    "remotion",
    "electron.vite.config.ts"
  ]
}
